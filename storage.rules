rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /tickets/{ticketId}/{fileName} {
      allow read: if request.auth != null && request.auth.token.staff == true;
      allow create, update: if request.auth != null && request.auth.token.staff == true
        && request.resource.size <= 25 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.token.staff == true;
    }
  }
}
